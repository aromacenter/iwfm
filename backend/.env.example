# Iwfm backend környezeti változók — másold .env néven és töltsd ki.

# Kötelező productionben:
WFM_ENVIRONMENT=development
WFM_SECRET_KEY=                # python -c "import secrets; print(secrets.token_urlsafe(48))"
WFM_ENC_KEY=                   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Adatbázis (Railway automatikusan adja DATABASE_URL néven):
# WFM_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/iwfm

# Frontend origin a CORS-hoz:
WFM_FRONTEND_ORIGIN=http://localhost:3000
WFM_COOKIE_SECURE=false        # production: true (productionben automatikusan true)

# Adatvédelem (GDPR):
WFM_PRIVACY_URL=               # adatkezelési tájékoztató URL — a belépő oldal lábléce linkeli
WFM_RETENTION_AUDIT_DAYS=0     # audit-napló megőrzése napban (0 = nincs automatikus törlés)
WFM_RETENTION_PHOTO_DAYS=0     # átvételi és munkalap-fotók megőrzése napban
WFM_RETENTION_SCREENSHOT_DAYS=0 # hibajegy-képernyőképek megőrzése napban
